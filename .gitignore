# 依赖
node_modules/
.npm-cache/
.electron-cache/
.electron-builder-cache/

# 构建产物
dist/
out/

# 运行时数据(冒烟测试的临时 DSH_HOME 等)
.runtime/

# UI 设计系统分析临时产物(从 node_modules 拷贝的研究素材)
.dsh-ui-src/

# 日志
*.log
logs/

# macOS
.DS_Store

# 编辑器
.vscode/
.idea/

# QA 报告产物
.gstack/

# demo
demo/

# key
id/

# 个人 Claude 配置（gitignored，不共享）
CLAUDE.local.md
.claude/settings.local.json
.claude/skills-personal/
.omc/

# 内置 Node 运行时(scripts/fetch-bundled-runtime.mjs 生成,体积大不入库;
# 保留 .gitkeep 使 assets/runtime 目录存在,electron-builder extraResources 不致 ENOENT)
assets/runtime/*
!assets/runtime/.gitkeep
